{
  "name": "mises",
  "version": "0.4.0-beta.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predev": "node scripts/prepare-vision.mjs",
    "prebuild": "node scripts/prepare-vision.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "dev:lan": "vite --host 0.0.0.0",
    "pwa:preview": "npm run build && vite preview --host 0.0.0.0",
    "check": "npm test && npm run build",
    "android:sync": "npm run build && node scripts/android-local.mjs sync",
    "android:apk": "npm run android:sync && node scripts/android-local.mjs apk",
    "android:pixel": "npm run android:apk && node scripts/android-local.mjs pixel"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "fake-indexeddb": "^6.2.5",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "@tensorflow-models/coco-ssd": "^2.2.3",
    "@tensorflow/tfjs": "^4.22.0",
    "@zxing/browser": "^0.2.1",
    "fuse.js": "^7.5.0",
    "idb": "^8.0.3",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
